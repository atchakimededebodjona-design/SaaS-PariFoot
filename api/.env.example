# Copier en .env pour le développement local (jamais commité — voir .gitignore).
# Chargé automatiquement au lancement via `uvicorn main:app --env-file .env`
# (uvicorn lit le fichier lui-même via python-dotenv — aucun code applicatif
# ne l'importe explicitement). Voir api/README.md.

JWT_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ENV=production

# --- Stripe (mode TEST — jamais de clés live en local) ---
# Récupérer STRIPE_SECRET_KEY sur Dashboard Stripe -> Développeurs -> Clés API.
# STRIPE_WEBHOOK_SECRET est généré automatiquement par `stripe listen`
# (voir section Stripe du README) — pas besoin de le créer dans le Dashboard
# pour tester en local.
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_LISTEN_OUTPUT
# Price ID créés dans Dashboard Stripe -> Produits (mode TEST) -> un produit
# avec 2 prix récurrents (mensuel, annuel) -> chaque prix a son propre price_...
STRIPE_PRICE_ID_MONTHLY=REPLACE_WITH_YOUR_MONTHLY_PRICE_ID
STRIPE_PRICE_ID_YEARLY=REPLACE_WITH_YOUR_YEARLY_PRICE_ID
FRONTEND_URL=http://localhost:3000
