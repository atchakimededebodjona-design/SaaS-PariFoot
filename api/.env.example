# Copier en .env pour le développement local (jamais commité — voir .gitignore).
# Chargé automatiquement au lancement via `uvicorn main:app --env-file .env`
# (uvicorn lit le fichier lui-même via python-dotenv — aucun code applicatif
# ne l'importe explicitement). Voir api/README.md.

JWT_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ENV=production

# Origines autorisées en CORS, séparées par des virgules — le frontend réel
# en production DOIT être listé ici, sinon le navigateur bloquera les
# appels. Défaut : uniquement le serveur de dev Next.js local.
ALLOWED_ORIGINS=http://localhost:3000

# --- Chariow (licences — voir section Facturation du README) ---
# CHARIOW_API_KEY : Paramètres -> Clés API du dashboard Chariow.
# ATTENTION : l'existence d'un mode test distinct des clés live n'est pas
# confirmée (à vérifier au même endroit avant de configurer une vraie clé).
CHARIOW_API_KEY=REPLACE_WITH_YOUR_CHARIOW_API_KEY
# CHARIOW_PULSE_SECRET : secret de signature défini en créant le Pulse
# (webhook) dans le dashboard Chariow -> Pulses, pointant vers
# POST /billing/pulse de cette API.
CHARIOW_PULSE_SECRET=REPLACE_WITH_YOUR_CHARIOW_PULSE_SECRET
# Product ID des 3 produits Licence créés dans le dashboard Chariow, en
# mode "Paiement unique" avec un prix FIXE (le mode "Prix libre" est exclu
# de l'API de checkout).
# Phase 15.1 — offres officielles (extraites des URLs de checkout
# https://jrykbuks.mychariow.co/{product_id}) :
#   biweekly = 1000 FCFA / 14 jours -> prd_1gje3jzz
#   monthly  = 1500 FCFA / 1 mois   -> prd_sgvapilx
#   yearly   = 28000 FCFA / 1 an    -> prd_f90jpbh3
CHARIOW_PRODUCT_ID_BIWEEKLY=REPLACE_WITH_YOUR_BIWEEKLY_PRODUCT_ID
CHARIOW_PRODUCT_ID_MONTHLY=REPLACE_WITH_YOUR_MONTHLY_PRODUCT_ID
CHARIOW_PRODUCT_ID_YEARLY=REPLACE_WITH_YOUR_YEARLY_PRODUCT_ID
FRONTEND_URL=http://localhost:3000

# --- Google Play Billing (Phase 2 — backend uniquement, aucun produit
# Play Console créé pour l'instant, voir app/billing/google_play_service.py) ---
# applicationId Android (cf. mobile/capacitor.config.json).
GOOGLE_PLAY_PACKAGE_NAME=site.xfoot.app
# Contenu JSON COMPLET du compte de service (jamais un chemin de fichier
# committé), scope androidpublisher. Créé dans Google Cloud Console, puis
# invité dans Play Console -> Utilisateurs et autorisations.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Confort dev local uniquement : chemin vers un fichier .json gitignored,
# utilisé seulement si la variable ci-dessus est absente.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# Modèle Play Console 2022+ : UN SEUL Product ID par abonnement, contenant
# plusieurs Base Plans (PAS un Product ID par période) — confirmé contre la
# doc officielle "Create and manage subscriptions" (Phase 3).
GOOGLE_PLAY_PRODUCT_ID=xfoot_premium
GOOGLE_PLAY_BASE_PLAN_ID_MONTHLY=monthly
GOOGLE_PLAY_BASE_PLAN_ID_YEARLY=yearly
# Protection intérimaire de POST /billing/google/rtdn avant configuration
# réelle de Google Cloud Pub/Sub (vérification OIDC définitive, non
# activable tant que ce projet n'existe pas).
GOOGLE_RTDN_SHARED_SECRET=

# --- API-Football (résultats réels — voir fetch_daily_results.py) ---
# Clé du dashboard https://dashboard.api-football.com/ — utilisée UNIQUEMENT
# par fetch_daily_results.py (cron séparé), pas par le service web api/main.py.
API_FOOTBALL_KEY=REPLACE_WITH_YOUR_API_FOOTBALL_KEY
